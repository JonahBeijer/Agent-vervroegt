# NovaAI: gebruik dezelfde externe nova.env als Taalmodel-vervroegt.
LLM_PROVIDER=nova
NOVA_API_KEY=vul-jouw-key-in
NOVA_BASE_URL=https://api.nova.datalabrotterdam.nl/v1
NOVA_MODEL=gemma4:26b

# Alternatief: LLM_PROVIDER=azure met onderstaande Azure-velden.
# Alleen voorbeeldwaarden. Bewaar echte credentials buiten de repository.
AZURE_OPENAI_API_KEY=vul-jouw-key-in
AZURE_OPENAI_API_INSTANCE_NAME=vul-jouw-instance-in
AZURE_OPENAI_API_DEPLOYMENT_NAME=vul-jouw-deployment-in
AZURE_OPENAI_MODEL_NAME=vul-de-werkelijke-modelnaam-in
AZURE_OPENAI_API_VERSION=vul-de-api-versie-in
# Niet nodig bij de standaard lokale embeddings:
AZURE_EMBEDDING_DEPLOYMENT_NAME=vul-jouw-embedding-deployment-in

# Optioneel: actuele praktijkvoorbeelden bij de cursus
NEWSDATA_API=vul-jouw-newsdata-key-in
# Extern env-bestand kiezen: stel AGENT_ENV_FILE in je shell in.
# PORT=3001
